# HI-Natya Verse backend environment configuration.
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file or its secrets.

# --- LLM providers (secrets live ONLY in backend/.env) ---
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=

# --- Story generation provider selection ---
STORY_PRIMARY_PROVIDER=gemini
# No production fallback provider. Gemini failures are returned as errors.
STORY_SECONDARY_PROVIDER=
# Live validated Story route only. Gemini is the production default.
STORY_LLM_PROVIDER=gemini

# Optional model overrides (defaults are used if omitted)
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_MODEL=qwen2.5-coder:7b  # development/test adapter only; never a production fallback

# --- Server ---
# HOST=127.0.0.1
# PORT=8000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Paths (project-relative defaults are used if omitted) ---
# UPLOAD_DIR=uploads
# FRAME_OUTPUT_DIR=frames
# RESULTS_DIR=results
# Optional FFmpeg executable overrides. If omitted, PATH and project-local tools/**/bin are checked.
# FFMPEG_PATH=tools/ffmpeg-9.0.1-essentials_build/ffmpeg-9.0.1-essentials_build/bin/ffmpeg.exe
# FFPROBE_PATH=tools/ffmpeg-9.0.1-essentials_build/ffmpeg-9.0.1-essentials_build/bin/ffprobe.exe
# MUDRA_MODEL_PATH=models/mudra/Natya_Mudra_EfficientNetB0_FineTuned.keras
# BHAVA_MODEL_PATH=models/bhava/bhava_phase3_moderated_best.keras
# POSE_MODEL_PATH=models/pose/Natya_Pose_BiLSTM_Best.keras
# POSE_CLASSES_PATH=models/pose/pose_class_names.json
# MUDRA_CLASSES_PATH=models/mudra/mudra_class_names.json
# BHAVA_METADATA_PATH=models/bhava/bhava_model_metadata.json
# MUDRA_KNOWLEDGE_PATH=app/data/knowledge/mudra_knowledge.json
