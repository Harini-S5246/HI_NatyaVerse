{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hi-natyaverse.local/schemas/performance-interpretation/1.0.0",
  "title": "HI-Natya Verse Performance Interpretation Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_id", "video_id", "source_type", "production_eligible", "performance_mode", "interpretation_status", "summary", "events", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "analysis_id": {"type": "string", "minLength": 1},
    "video_id": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "enum": ["curated_annotation", "synthetic_test_fixture"]},
    "production_eligible": {"type": "boolean"},
    "performance_mode": {"$ref": "narrative_evidence.schema.json#/$defs/performance_mode"},
    "interpretation_status": {"type": "string", "enum": ["available", "unavailable"]},
    "summary": {"type": "string", "minLength": 1},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_reference", "confidence"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "source_reference": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "start_time", "end_time", "type", "statement", "evidence"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "start_time": {"type": ["number", "null"], "minimum": 0},
        "end_time": {"type": ["number", "null"], "minimum": 0},
        "type": {"type": "string", "enum": ["verified_performance_event", "verified_narrative_event", "recorded_model_observation"]},
        "statement": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  }
}
